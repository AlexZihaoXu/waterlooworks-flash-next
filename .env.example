# Backend runtime only. Owner supplies canonical base64 of the service-account JSON.
# Never prefix this variable with VITE_, commit its value, or bake it into an image.
FIREBASE_SERVICE_ACCOUNT=

# Exact browser origins, comma-separated, with no trailing slash or wildcard.
WW_AUTH_ORIGINS=https://localhost
# Default secure cookies/HTTPS. Only explicit loopback HTTP development may use 1.
WW_AUTH_ALLOW_LOOPBACK_HTTP=0
