# Local backend runtime only. Owner supplies canonical base64 of service-account JSON.
# Never prefix secrets with VITE_, commit values or bake them into an image.
FIREBASE_SERVICE_ACCOUNT=
# Existing independent Fernet key: initialize only with the explicit offline command.
# WW_CREDENTIALS_KEY=

# Alternative: absolute read-only regular files with the SAME encoding as env values.
# Remove the corresponding env assignment entirely (even empty) before using _FILE.
# FIREBASE_SERVICE_ACCOUNT_FILE=/absolute/private/firebase-service-account.base64
# WW_CREDENTIALS_KEY_FILE=/absolute/private/ww-credentials.key

# Exact browser origins, comma-separated, with no trailing slash or wildcard.
WW_AUTH_ORIGINS=https://localhost
# Default secure cookies/HTTPS. Only explicit loopback HTTP development may use 1.
WW_AUTH_ALLOW_LOOPBACK_HTTP=0
# No proxy trust by default. Production Compose supplies one concrete internal peer.
# WW_AUTH_TRUSTED_PROXY=172.30.87.2
# For containers use deployment/production.env.example, NOT this runtime secret file.
