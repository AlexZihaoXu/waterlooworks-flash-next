worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    sendfile on;
    client_max_body_size 20k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    # The operator terminator admits only Cloudflare for this host (see
    # docs/deployment.md), and Cloudflare overwrites CF-Connecting-IP with the
    # visitor's address, so it tells clients apart. A missing or malformed
    # value (local access) falls back to the peer address.
    map $http_cf_connecting_ip $ww_client {
        "~^[0-9A-Fa-f:.]{2,45}$" $http_cf_connecting_ip;
        default $binary_remote_addr;
    }
    # Anonymous auth endpoints (prepare/exchange) are bounded per client and,
    # as a backstop, in total; every other URI maps to an empty key, which
    # limit_req never limits. The cookie-gated session check and logout stay
    # unlimited so a flood on prepare can never 429 (and so sign out)
    # already signed-in users.
    map $uri $ww_auth_client_key {
        ~^/api/auth/(prepare|exchange)$ $ww_client;
        default "";
    }
    map $uri $ww_auth_total_key {
        ~^/api/auth/(prepare|exchange)$ auth;
        default "";
    }
    # Agent API callers (bearer tokens and the public docs) per client; the
    # backend adds its own per-token budget.
    map $uri $ww_agent_client_key {
        ~^/api/agent/ $ww_client;
        default "";
    }
    limit_req_zone $ww_auth_client_key zone=ww_auth_client:10m rate=2r/s;
    limit_req_zone $ww_auth_total_key zone=ww_auth_total:1m rate=20r/s;
    limit_req_zone $ww_agent_client_key zone=ww_agent:10m rate=5r/s;
    limit_req_status 429;
    server {
        listen 8080;
        server_name ${WW_PUBLIC_HOST};
        if ($http_host != "${WW_PUBLIC_HOST}") { return 403; }
        root /usr/share/nginx/html;
        # Security headers live at server level only: nginx drops inherited
        # add_header directives in any location that declares its own.
        # CSP allows only this origin plus the Firebase Auth popup flow:
        # gapi from apis.google.com, the authDomain iframe, the Identity
        # Toolkit/Secure Token APIs and Google avatar hosts. HeroUI/React Aria
        # inject runtime <style> elements, hence style-src 'unsafe-inline'.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://lh3.googleusercontent.com https://lh4.googleusercontent.com https://lh5.googleusercontent.com https://lh6.googleusercontent.com; font-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://alex-xu-central.firebaseapp.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
        # Browsers honor HSTS only over HTTPS; the operator terminator relays it.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        # signInWithPopup needs the opener relationship with its popup.
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        location ~ ^/api(/|$) {
            limit_req zone=ww_auth_client burst=20 nodelay;
            limit_req zone=ww_auth_total burst=60 nodelay;
            limit_req zone=ww_agent burst=30 nodelay;
            proxy_pass http://backend:8787;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host "${WW_PUBLIC_HOST}";
            # The operator TLS terminator can reach this loopback-only listener.
            # Never propagate a browser-supplied forwarding claim.
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header X-Real-IP "";
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_read_timeout 75s;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
        }
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
