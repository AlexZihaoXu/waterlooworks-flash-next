# Non-secret Compose interpolation ONLY. Use --env-file explicitly; never root .env.
# Owner chooses a Tailscale-only hostname or public DNS hostname plus actual TLS.
WW_PUBLIC_HOST=example.invalid
# These are private operator-provisioned absolute paths, outside the source tree.
# Both files contain the SAME encoding as local env inputs; see deployment.md.
WW_FIREBASE_SECRET_PATH=/operator/private/firebase-service-account.base64
WW_KEY_SECRET_PATH=/operator/private/ww-credentials.key
# Browse-only until separate headless/Duo/provider pilot authorization.
WW_ENABLE_REFRESH=0
WW_DETAIL_LIMIT=12
WW_OPENAI_REQUEST_LIMIT=20
WW_OPENAI_KNOWN_COST_STOP_USD=1
